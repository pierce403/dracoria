FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node-runtime
FROM mongo:8.3.11@sha256:d731d77bfd7afd66bd487bdf627b5bf7ce4c3602ec461d635977021db529ebbc
COPY --from=node-runtime /usr/local /usr/local
ENV GLIBC_TUNABLES=glibc.pthread.rseq=1
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js ./
COPY models ./models
COPY routes ./routes
COPY services ./services
COPY utils ./utils
COPY views ./views
COPY public ./public
COPY scripts/staging-entry.cjs ./scripts/staging-entry.cjs
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["node","scripts/staging-entry.cjs"]
